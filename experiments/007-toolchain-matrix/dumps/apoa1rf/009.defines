context	ACOS	acos
context	APPLY_PERIODIC_TO_DELTA(delta)	delta.xyz -= floor(delta.xyz*invPeriodicBoxSize.xyz+0.5f)*periodicBoxSize.xyz;
context	APPLY_PERIODIC_TO_POS(pos)	pos.xyz -= floor(pos.xyz*invPeriodicBoxSize.xyz)*periodicBoxSize.xyz;
context	APPLY_PERIODIC_TO_POS_WITH_CENTER(pos, center)	{pos.x -= floor((pos.x-center.x)*invPeriodicBoxSize.x+0.5f)*periodicBoxSize.x; \
pos.y -= floor((pos.y-center.y)*invPeriodicBoxSize.y+0.5f)*periodicBoxSize.y; \
pos.z -= floor((pos.z-center.z)*invPeriodicBoxSize.z+0.5f)*periodicBoxSize.z;}
context	ASIN	asin
context	ATAN	atan
context	COS	cos
context	ERF	erf
context	ERFC	erfc
context	EXP	native_exp
context	FABS	fabs
context	FMA	fma
context	LOG	native_log
context	POW	pow
context	RECIP	native_recip
context	RSQRT	native_rsqrt
context	SIN	sin
context	SQRT	native_sqrt
context	SYNC_WARPS	mem_fence(CLK_LOCAL_MEM_FENCE)
context	TAN	tan
context	convert_mixed4	convert_float4
context	convert_real4	convert_float4
context	make_mixed2	make_float2
context	make_mixed3	make_float3
context	make_mixed4	make_float4
context	make_real2	make_float2
context	make_real3	make_float3
context	make_real4	make_float4
program	BIN_SHIFT	12
program	BLOCK_INDEX_MASK	4095
program	BUFFER_GROUPS	2
program	GROUP_SIZE	256
program	MAX_EXCLUSIONS	4
program	NUM_ATOMS	92224
program	NUM_BLOCKS	2882
program	NUM_TILES_WITH_EXCLUSIONS	5213
program	PADDED_CUTOFF	1.10000000e+00f
program	PADDED_CUTOFF_SQUARED	1.21000000e+00f
program	PADDING	1.00000000e-01f
program	SIMD_WIDTH	32
program	TILE_SIZE	32
