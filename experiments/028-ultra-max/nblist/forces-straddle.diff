     return evaluate(context)
 
 
+def straddling(system, reached, error):
+    """Atoms among the largest errors that have a pair within float rounding of the cutoff."""
+    nonbonded = [f for f in system.getForces() if isinstance(f, mm.NonbondedForce)]
+    if not nonbonded or nonbonded[0].getNonbondedMethod() == mm.NonbondedForce.NoCutoff:
+        return []
+    force = nonbonded[0]
+    cutoff = force.getCutoffDistance().value_in_unit(u.nanometer)
+    periodic = force.usesPeriodicBoundaryConditions()
+    box = np.array([v.value_in_unit(u.nanometer) for v in system.getDefaultPeriodicBoxVectors()]).diagonal()
+    band = STRADDLE_ULPS*np.spacing(np.float32(box.max() if periodic else np.abs(reached).max()))
+    exceptions = {}
+    for k in range(force.getNumExceptions()):
+        i, j, *_ = force.getExceptionParameters(k)
+        exceptions.setdefault(i, set()).add(j)
+        exceptions.setdefault(j, set()).add(i)
+    atoms = []
+    for i in np.argsort(-np.linalg.norm(error, axis=1))[:STRADDLE_CANDIDATES]:
+        delta = reached-reached[i]
+        if periodic:
+            delta -= box*np.round(delta/box)
+        near = np.flatnonzero(np.abs(np.linalg.norm(delta, axis=1)-cutoff) < band)
+        if any(j != i and j not in exceptions.get(i, ()) for j in near):
+            atoms.append(i)
+    return atoms
+
