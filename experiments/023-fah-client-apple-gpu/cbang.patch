+#ifdef __APPLE__
+
+#include "MacOSGPU.h"
+#include "MacOSString.h"
+
+#include <cbang/String.h>
+
+#include <IOKit/IOKitLib.h>
+
+using namespace cb;
+using namespace std;
+
+
+uint16_t cb::getAppleGPUDeviceID() {
+  io_iterator_t iter;
+  if (IOServiceGetMatchingServices(
+        MACH_PORT_NULL, IOServiceMatching("IOAccelerator"), &iter) !=
+      kIOReturnSuccess) return 0;
+
+  uint16_t id = 0;
+  io_service_t dev;
+  while (!id && (dev = IOIteratorNext(iter))) {
+    MacOSRef<CFTypeRef> ref(IORegistryEntryCreateCFProperty(
+      dev, CFSTR("IONameMatched"), kCFAllocatorDefault, 0));
+    IOObjectRelease(dev);
+    if (!ref || CFGetTypeID(ref) != CFStringGetTypeID()) continue;
+
+    // Expect "gpu,t" plus four hex digits, e.g. "gpu,t8112" on M2
+    string name = MacOSString::convert((CFStringRef)ref.get());
+    if (name.size() == 9 && String::startsWith(name, "gpu,t"))
+      String::parseU16("0x" + name.substr(5), id, true);
+  }
+
+  IOObjectRelease(iter);
+
+  return id;
+}
+
+#endif // __APPLE__
