From 775da3433f46e3115548dea79d4f857efd97fe91 Mon Sep 17 00:00:00 2001
From: Amir Ayub <dev.amirayub@gmail.com>
Date: Wed, 23 Sep 2026 21:41:50 +0300
Subject: [PATCH] Identify Apple silicon GPUs

Add VENDOR_APPLE, 0x106b, Apple's PCI vendor ID.  Map the OpenCL vendor
ID 0x1027f00 that Apple silicon GPUs report to 0x106b.  Add
getAppleGPUDeviceID(), which reads the SoC ID from the GPU's IOKit
IONameMatched property.  For example "gpu,t8112" gives 0x8112 on M2.
---
 src/cbang/hw/GPUVendor.h       |  1 +
 src/cbang/hw/OpenCLLibrary.cpp |  3 ++
 src/cbang/os/osx/MacOSGPU.cpp  | 71 ++++++++++++++++++++++++++++++++++
 src/cbang/os/osx/MacOSGPU.h    | 47 ++++++++++++++++++++++
 4 files changed, 122 insertions(+)
 create mode 100644 src/cbang/os/osx/MacOSGPU.cpp
 create mode 100644 src/cbang/os/osx/MacOSGPU.h

diff --git a/src/cbang/hw/GPUVendor.h b/src/cbang/hw/GPUVendor.h
index ee8e8498..d9011dde 100644
--- a/src/cbang/hw/GPUVendor.h
+++ b/src/cbang/hw/GPUVendor.h
@@ -47,6 +47,7 @@
 CBANG_ENUM_VALUE(VENDOR_UNKNOWN, 0)
 CBANG_ENUM_VALUE(VENDOR_AMD,     0x1002)
 CBANG_ENUM_ALIAS(VENDOR_ATI,     VENDOR_AMD)
+CBANG_ENUM_VALUE(VENDOR_APPLE,   0x106b)
 CBANG_ENUM_VALUE(VENDOR_NVIDIA,  0x10de)
 CBANG_ENUM_VALUE(VENDOR_INTEL,   0x8086)
 
diff --git a/src/cbang/hw/OpenCLLibrary.cpp b/src/cbang/hw/OpenCLLibrary.cpp
index 12dfaf30..3ab612fc 100644
--- a/src/cbang/hw/OpenCLLibrary.cpp
+++ b/src/cbang/hw/OpenCLLibrary.cpp
@@ -336,6 +336,9 @@ int32_t OpenCLLibrary::getVendorID(void *device) {
   // Integrated AMD cards on Apple return wrong vendor ID
   if (vendorID == 0x1021d00) vendorID = 0x1002;
 
+  // Apple silicon GPUs return a non-PCI vendor ID
+  if (vendorID == 0x1027f00) vendorID = GPUVendor::VENDOR_APPLE;
+
   return vendorID;
 }
 
