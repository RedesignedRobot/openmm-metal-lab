+
+namespace cb {
+  /// @return The Apple SoC ID of the integrated GPU, e.g. 0x8112 for M2, or
+  /// 0 if none is found.  Apple silicon GPUs are not PCI devices, so this ID
+  /// stands in for the PCI device ID.
+  uint16_t getAppleGPUDeviceID();
