From 3029beaded9f1f65331ff24bca1c8baf5e3e7ace Mon Sep 17 00:00:00 2001
From: Amir Ayub <dev.amirayub@gmail.com>
Date: Wed, 23 Sep 2026 21:41:50 +0300
Subject: [PATCH] Detect Apple silicon GPUs

Apple silicon GPUs have no PCI address, so detect() dropped them.  On
macOS, keep an Apple OpenCL GPU without PCI info as gpu:soc:<n>.  Use its
SoC ID as the device ID and mark it supported when gpus.json lists a
species for vendor 0x106b and that ID.

Needs the matching cbang change.  See #303.
---
 src/fah/client/GPUResources.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/src/fah/client/GPUResources.cpp b/src/fah/client/GPUResources.cpp
index df95afa..da55560 100644
--- a/src/fah/client/GPUResources.cpp
+++ b/src/fah/client/GPUResources.cpp
@@ -42,8 +42,13 @@
 #include <cbang/hw/OpenCLLibrary.h>
 #include <cbang/hw/CUDALibrary.h>
 #include <cbang/hw/HIPLibrary.h>
+#include <cbang/hw/GPUVendor.h>
 #include <cbang/util/WeakCallback.h>
 
+#ifdef __APPLE__
+#include <cbang/os/osx/MacOSGPU.h>
+#endif
+
 using namespace FAH::Client;
 using namespace cb;
 using namespace std;
@@ -220,6 +225,27 @@ void GPUResources::detect() {
       res->insert("description", gpu.getDescription());
   }
 
+#ifdef __APPLE__
+  // Apple silicon GPUs are not PCI devices.  Identify them by SoC ID.
+  // Assumes one GPU per SoC.
+  uint16_t deviceID = getAppleGPUDeviceID();
+  const auto &gpu = gpuIndex.find(GPUVendor::VENDOR_APPLE, deviceID);
+  unsigned socIndex = 0;
+
+  for (auto &cd: openclGPUs) {
+    if (cd.isPCIValid() || cd.vendorID != GPUVendor::VENDOR_APPLE) continue;
+
+    string id = "gpu:soc:" + String(socIndex++);
+
+    auto res = resources[id] = new GPUResource(id);
+    res->set("opencl", cd);
+    res->insert("device", deviceID);
+    res->insertBoolean("supported", gpu.getSpecies());
+
+    if (gpu.getSpecies()) valid.insert(id);
+  }
+#endif // __APPLE__
+
   // Match with existing GPUResources
   bool changed = false;
   for (auto &p: resources) {
-- 
