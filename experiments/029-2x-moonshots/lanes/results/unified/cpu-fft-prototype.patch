@@ -0,0 +1,20 @@
+#ifndef OPENMM_METAL_CPU_FFT_H_
+#define OPENMM_METAL_CPU_FFT_H_
+
+namespace OpenMM {
+class MetalContext;
+class ArrayInterface;
+
+// A real 3D FFT over the existing shared Metal grids.  Only line-sized CPU
+// arithmetic scratch is allocated; there are no grid transfers or shadow grids.
+class MetalCpuFFT {
+public:
+    MetalCpuFFT(MetalContext& context, int x, int y, int z);
+    ~MetalCpuFFT();
+    void exec(ArrayInterface& in, ArrayInterface& out, bool forward);
+private:
+    struct Impl;
+    Impl* impl;
+};
+}
+#endif
