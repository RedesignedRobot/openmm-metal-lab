+// Preserve the Common 64-thread sum order, but perform its final five levels
+// within each SIMD group. Both SIMD groups compute the same folded result.
+DEVICE float4 foldMomentum(float4 value, LOCAL_ARG float4* temp) {
+    temp[LOCAL_ID] = value;
+    SYNC_THREADS;
+    uint lane = LOCAL_ID & 31;
+    value = temp[lane]+temp[lane+32];
+    for (ushort offset = 16; offset > 0; offset >>= 1)
+        value += simd_shuffle_down(value, offset);
+    return simd_shuffle(value, 0);
+}
+
+KERNEL void calcCenterOfMassMomentum(int numAtoms, GLOBAL const mixed4* RESTRICT velm,
+        GLOBAL float4* RESTRICT cmMomentum) {
+    LOCAL float4 temp[64];
+    float4 cm = make_float4(0);
+    for (int index = GLOBAL_ID; index < numAtoms; index += GLOBAL_SIZE) {
+        mixed4 velocity = velm[index];
+        if (velocity.w != 0) {
+            mixed mass = RECIP(velocity.w);
+            cm.x += (float) (velocity.x*mass);
+            cm.y += (float) (velocity.y*mass);
+            cm.z += (float) (velocity.z*mass);
+        }
+    }
+    cm = foldMomentum(cm, temp);
+    if (LOCAL_ID == 0)
+        cmMomentum[GROUP_ID] = cm;
+}
+
+KERNEL void removeCenterOfMassMomentum(int numAtoms, GLOBAL mixed4* RESTRICT velm,
+        GLOBAL const float4* RESTRICT cmMomentum) {
+    LOCAL float4 temp[64];
+    float4 cm = make_float4(0);
+    for (int index = LOCAL_ID; index < NUM_GROUPS; index += LOCAL_SIZE)
+        cm += cmMomentum[index];
+    cm = INVERSE_TOTAL_MASS*foldMomentum(cm, temp);
+    for (int index = GLOBAL_ID; index < numAtoms; index += GLOBAL_SIZE) {
+        mixed4 velocity = velm[index];
+        velocity.x -= cm.x;
+        velocity.y -= cm.y;
+        velocity.z -= cm.z;
+        velm[index] = velocity;
+    }
+}
