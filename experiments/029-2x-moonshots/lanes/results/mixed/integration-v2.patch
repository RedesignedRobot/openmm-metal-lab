+#ifdef USE_MIXED_PRECISION
+// Each quartet carries an unnormalized high/low expansion. At each butterfly
+// level, magnitude ordering makes FastTwoSum exact for the high components.
+// Low components retain the rounding residuals without serial df64 additions.
+// All lanes receive one result so convergence decisions remain uniform.
+DEVICE float2 shakeCompensatedSum(float2 value) {
+    ushort lane = LOCAL_ID & 31;
+    for (ushort mask = 1; mask < 4; mask <<= 1) {
+        float2 other = simd_shuffle(value, (ushort) (lane^mask));
+        bool larger = fabs(value.x) >= fabs(other.x);
+        float big = larger ? value.x : other.x;
+        float small = larger ? other.x : value.x;
+        float sum = value.x+other.x;
+        float error = small-(sum-big);
+        value = float2(sum, (value.y+other.y)+error);
+    }
+    return simd_shuffle(value, (ushort) (lane & ~3u));
+}
+
+DEVICE float2 shakeCompensatedDot(mixed a, mixed b) {
+    float2 product = df64_two_prod(a.hi, b.hi);
+    product.y += fma(a.lo, b.hi, a.hi*b.lo);
+    return shakeCompensatedSum(product);
+}
+
+// Four adjacent lanes own x, y, z and a zero padding component. Position and
+// velocity specializations omit each other's precomputation. Bond corrections
+// retain SHAKE's Gauss-Seidel order and the existing float correction formula.
+template <bool velocities>
+DEVICE void cooperativeShake(int4 atoms, float4 params, mixed tol, int component,
+        PRIVATE const mixed* pos, PRIVATE mixed* value) {
+    if (atoms.y == -1)
+        return;
+    mixed direction[3];
+    float2 norm[3];
+    float realDirection[3], velocityNorm[3];
+    for (int j = 0; j < 3; j++) {
+        direction[j] = pos[0]-pos[j+1];
+        realDirection[j] = (float) direction[j];
+        if (velocities) {
+            float sq = realDirection[j]*realDirection[j];
+            uint base = (uint) (LOCAL_ID & 31) & ~3u;
+            velocityNorm[j] = (simd_shuffle(sq, base)+simd_shuffle(sq, base+1))+simd_shuffle(sq, base+2);
+        }
+        else
+            norm[j] = shakeCompensatedDot(direction[j], direction[j]);
+    }
+    float maxResidual = params.z*(float) tol;
+    for (int iteration = 0; iteration < 15; iteration++) {
+        bool converged = true;
+        for (int j = 0; j < 3; j++) {
+            if (atoms[j+1] == -1)
+                continue;
+            mixed difference = value[0]-value[j+1];
+            float correction;
+            if (velocities) {
+                float2 product = shakeCompensatedDot(difference, direction[j]);
+                correction = -2.0f*params.y*(product.x+product.y)/velocityNorm[j];
+                if (fabs(correction) > tol)
+                    converged = false;
+            }
+            else {
+                float2 product = shakeCompensatedDot(direction[j], difference);
+                float2 square = shakeCompensatedDot(difference, difference);
+                // The four lanes sum d2 - norm - 2*dot - deltaSquared as
+                // expansions, preserving cancellation before the float cast.
+                float2 term = component == 0 ? float2(params.z, 0) :
+                              component == 1 ? -norm[j] :
+                              component == 2 ? -2.0f*product : -square;
+                float2 residualParts = shakeCompensatedSum(term);
+                float residual = residualParts.x+residualParts.y;
+                if (fabs(residual) < maxResidual)
+                    continue;
+                correction = residual*params.y/((product.x+product.y)+(norm[j].x+norm[j].y));
+                converged = false;
+            }
+            float shift = realDirection[j]*correction;
+            value[0] += shift*params.x;
+            value[j+1] -= shift*params.w;
+        }
+        if (converged)
+            break;
+    }
+}
+
+DEVICE void cooperativeShakeStep(int4 atoms, float4 params, mixed tol, int component, int paddedNumAtoms,
+        GLOBAL real4* posq, GLOBAL real4* posqCorrection, GLOBAL mixed4* velm,
+        GLOBAL const mm_long* force, GLOBAL const mixed* paramBuffer, GLOBAL const mixed2* dt,
+        GLOBAL const float4* random, unsigned int randomIndex) {
+    mixed pos[4], vel[4], delta[4], oldDelta[4], invMass[4];
+    mixed fscale = dt[0].y/(mixed) 0x100000000;
+    mixed halfdt = 0.5f*dt[0].y;
+    mixed invDt = 1/dt[0].y;
+    for (int j = 0; j < 4; j++) {
+        pos[j] = vel[j] = delta[j] = oldDelta[j] = invMass[j] = 0;
+        int atom = atoms[j];
+        if (atom == -1)
+            continue;
+        invMass[j] = velm[atom].w;
+        if (component < 3) {
+            pos[j] = (mixed) ((GLOBAL real*) posq)[4*atom+component] +
+                    ((GLOBAL real*) posqCorrection)[4*atom+component];
+            vel[j] = ((GLOBAL mixed*) velm)[4*atom+component];
+            if (invMass[j] != 0)
+                vel[j] += fscale*invMass[j]*force[atom+component*paddedNumAtoms];
+        }
+    }
+    cooperativeShake<true>(atoms, params, tol, component, pos, vel);
+    for (int j = 0; j < 4; j++) {
+        int atom = atoms[j];
+        if (atom == -1 || invMass[j] == 0)
+            continue;
+        delta[j] = halfdt*vel[j];
+        float noise = component < 3 ? random[randomIndex+atom][component] : 0;
+        vel[j] = paramBuffer[0]*vel[j] + paramBuffer[1]*SQRT(invMass[j])*noise;
+        delta[j] += halfdt*vel[j];
+        oldDelta[j] = delta[j];
+    }
+    cooperativeShake<false>(atoms, params, tol, component, pos, delta);
+    for (int j = 0; j < 4; j++) {
+        int atom = atoms[j];
+        if (atom == -1 || invMass[j] == 0 || component == 3)
+            continue;
+        vel[j] += (delta[j]-oldDelta[j])*invDt;
+        ((GLOBAL mixed*) velm)[4*atom+component] = vel[j];
+        mixed newPos = pos[j]+delta[j];
+        real hi = (real) newPos;
+        ((GLOBAL real*) posq)[4*atom+component] = hi;
+        ((GLOBAL real*) posqCorrection)[4*atom+component] = (real) (newPos-hi);
+    }
+}
+
+KERNEL void applyCooperativeShake(int numClusters, mixed tol, GLOBAL const real4* oldPos,
+        GLOBAL mixed4* values, GLOBAL const int4* clusterAtoms, GLOBAL const float4* clusterParams,
+        GLOBAL const real4* posqCorrection, int velocities) {
+    int component = LOCAL_ID & 3;
+    for (int index = GLOBAL_ID/4; index < numClusters; index += GLOBAL_SIZE/4) {
+        int4 atoms = clusterAtoms[index];
+        mixed pos[4], value[4];
+        for (int j = 0; j < 4; j++) {
+            pos[j] = value[j] = 0;
+            int atom = atoms[j];
+            if (atom != -1 && component < 3) {
+                pos[j] = (mixed) ((GLOBAL const real*) oldPos)[4*atom+component] +
+                        ((GLOBAL const real*) posqCorrection)[4*atom+component];
+                value[j] = ((GLOBAL mixed*) values)[4*atom+component];
+            }
+        }
+        if (velocities)
+            cooperativeShake<true>(atoms, clusterParams[index], tol, component, pos, value);
+        else
+            cooperativeShake<false>(atoms, clusterParams[index], tol, component, pos, value);
+        for (int j = 0; j < 4; j++)
+            if (atoms[j] != -1 && component < 3)
+                ((GLOBAL mixed*) values)[4*atoms[j]+component] = value[j];
+    }
+}
+#endif
