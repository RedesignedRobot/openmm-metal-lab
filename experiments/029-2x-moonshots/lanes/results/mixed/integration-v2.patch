+
+void MetalRemoveCMMotionKernel::initialize(const System& system, const CMMotionRemover& force) {
+    ContextSelector selector(cu);
+    int numAtoms = cu.getNumAtoms();
+    // Only one momentum per dispatched group is needed, not one per atom.
+    cmMomentum.initialize<mm_float4>(cu, max(1, min(cu.getNumThreadBlocks(), (numAtoms+63)/64)), "cmMomentum");
+    double totalMass = 0;
+    for (int i = 0; i < numAtoms; i++)
+        totalMass += system.getParticleMass(i);
+    map<string, string> defines;
+    defines["INVERSE_TOTAL_MASS"] = cu.doubleToString(totalMass == 0 ? 0 : 1/totalMass);
+    ComputeProgram program = cu.compileProgram(MetalKernelSources::removeCM, defines);
+    calcKernel = program->createKernel("calcCenterOfMassMomentum");
+    removeKernel = program->createKernel("removeCenterOfMassMomentum");
+    for (ComputeKernel kernel : {calcKernel, removeKernel}) {
+        kernel->addArg(numAtoms);
+        kernel->addArg(cu.getVelm());
+        kernel->addArg(cmMomentum);
+    }
+}
+
+void MetalRemoveCMMotionKernel::execute(ContextImpl& context) {
+    ContextSelector selector(cu);
+    calcKernel->execute(cu.getNumAtoms(), 64);
+    removeKernel->execute(cu.getNumAtoms(), 64);
+}
