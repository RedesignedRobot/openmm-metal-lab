index 000000000..f0a04def6
--- /dev/null
+++ b/platforms/metal/src/kernels/nonbondedForceRecords.metal
@@ -0,0 +1,97 @@
+// Build the reverse incidence index only when the existing neighbor list rebuilds.
+// Integer atomics construct the index.  The pair kernel never atomically adds a
+// force when its list fits these records.  Oversized lists use the old kernel.
+#define RECORDS_FIT (interactionCount[0] <= maxTiles && interactionCount[0] <= FORCE_TILE_CAPACITY-NUM_EXCLUSION_TILES)
+#define REBUILD_RECORDS (rebuild[0] && RECORDS_FIT)
+#define RECORD_ATOM \
+    unsigned int tile = record/64, lane = record%32; \
+    bool second = (record%64 >= 32); \
+    unsigned int atom; \
+    if (tile < NUM_EXCLUSION_TILES) { \
+        int2 pair = exclusionTiles[tile]; \
+        atom = 32*(second ? pair.y : pair.x)+lane; \
+    } else { \
+        tile -= NUM_EXCLUSION_TILES; \
+        atom = second ? interactingAtoms[32*tile+lane] : 32*tiles[tile]+lane; \
+    }
+
+extern "C" __global__ void clearForceRecordCounts(unsigned int* counts, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!REBUILD_RECORDS) return;
+    for (unsigned int atom = GLOBAL_ID; atom < NUM_ATOMS; atom += GLOBAL_SIZE)
+        counts[atom] = 0;
+}
+
+extern "C" __global__ void countForceRecords(unsigned int* counts,
+        const int2* exclusionTiles, const int* tiles, const int* interactingAtoms, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!REBUILD_RECORDS) return;
+    unsigned int records = 64*(NUM_EXCLUSION_TILES+interactionCount[0]);
+    for (unsigned int record = GLOBAL_ID; record < records; record += GLOBAL_SIZE) {
+        RECORD_ATOM
+        if (atom < NUM_ATOMS)
+            atomic_fetch_add_explicit((device atomic_uint*) &counts[atom], 1u, memory_order_relaxed);
+    }
+}
+
+// 128 threads, four Apple SIMD groups.  Every thread reaches the barrier,
+// including padding threads in the final group.
+extern "C" __global__ void scanForceRecords(const unsigned int* input, unsigned int* output,
+        unsigned int* sums, unsigned int size, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!REBUILD_RECORDS) return;
+    threadgroup unsigned int simdSums[4];
+    unsigned int index = GLOBAL_ID;
+    unsigned int value = (index < size ? input[index] : 0);
+    unsigned int prefix = simd_prefix_inclusive_sum(value);
+    unsigned int simd = LOCAL_ID/32;
+    if (LOCAL_ID%32 == 31) simdSums[simd] = prefix;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    unsigned int carry = 0;
+    for (unsigned int group = 0; group < simd; group++) carry += simdSums[group];
+    if (index < size) output[index] = carry+prefix-value;
+    if (LOCAL_ID == 127) sums[GROUP_ID] = carry+prefix;
+}
+
+extern "C" __global__ void addForceRecordScan(unsigned int* output,
+        const unsigned int* parentOffsets, unsigned int size, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!REBUILD_RECORDS) return;
+    for (unsigned int index = GLOBAL_ID; index < size; index += GLOBAL_SIZE)
+        output[index] += parentOffsets[index/128];
+}
+
+extern "C" __global__ void finishForceRecordScan(unsigned int* counts,
+        unsigned int* offsets, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!REBUILD_RECORDS) return;
+    for (unsigned int atom = GLOBAL_ID; atom < NUM_ATOMS; atom += GLOBAL_SIZE) {
+        if (atom == NUM_ATOMS-1) offsets[NUM_ATOMS] = offsets[atom]+counts[atom];
+        counts[atom] = 0;
+    }
+}
+
+extern "C" __global__ void scatterForceRecords(unsigned int* counts,
+        const unsigned int* offsets, unsigned int* indices,
+        const int2* exclusionTiles, const int* tiles, const int* interactingAtoms, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!REBUILD_RECORDS) return;
+    unsigned int records = 64*(NUM_EXCLUSION_TILES+interactionCount[0]);
+    for (unsigned int record = GLOBAL_ID; record < records; record += GLOBAL_SIZE) {
+        RECORD_ATOM
+        if (atom < NUM_ATOMS) {
+            unsigned int slot = atomic_fetch_add_explicit((device atomic_uint*) &counts[atom], 1u, memory_order_relaxed);
+            indices[offsets[atom]+slot] = record;
+        }
+    }
+}
+
+extern "C" __global__ void reduceForceRecords(const float* records,
+        const unsigned int* offsets, const unsigned int* indices,
+        unsigned long long* forces, const unsigned int* interactionCount, const int* rebuild, unsigned int maxTiles) {
+    if (!RECORDS_FIT) return;
+    for (unsigned int atom = GLOBAL_ID; atom < NUM_ATOMS; atom += GLOBAL_SIZE) {
+        float3 force = float3(0);
+        for (unsigned int slot = offsets[atom]; slot < offsets[atom+1]; slot++) {
+            unsigned int record = 3*indices[slot];
+            force += float3(records[record], records[record+1], records[record+2]);
+        }
+        atomicAdd(&forces[atom], static_cast<unsigned long long>(realToFixedPoint(force.x)));
+        atomicAdd(&forces[atom+PADDED_NUM_ATOMS], static_cast<unsigned long long>(realToFixedPoint(force.y)));
+        atomicAdd(&forces[atom+2*PADDED_NUM_ATOMS], static_cast<unsigned long long>(realToFixedPoint(force.z)));
+    }
+}
