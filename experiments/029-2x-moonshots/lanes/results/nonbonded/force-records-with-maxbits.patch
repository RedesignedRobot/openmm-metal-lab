+    void* scatterArgs[] = {&forceRecordCounts.getDevicePointer(), &forceRecordOffsets.getDevicePointer(),
+        &forceRecordIndices.getDevicePointer(), &exclusionTiles.getDevicePointer(), &interactingTiles.getDevicePointer(),
+        &interactingAtoms.getDevicePointer(), count, rebuild, &maxTiles};
+    context.executeKernelFlat(scatterForceRecords, scatterArgs, threads, 128);
