+            context.getPlatformData().deterministicForces || !canUsePairList ||
+            !useNeighborList || useLJPME || context.getNumAtoms() < 30000 ||
+            context.getPlatformData().contexts.size() != 1 || kernelSource != MetalKernelSources::nonbonded)
+        return;
+    auto allocationSize = [&](size_t bytes) {
+        return context.getDevice()->heapBufferSizeAndAlign(bytes, MTL::ResourceStorageModeShared).size;
+    };
+    size_t budget = min<size_t>(context.getDevice()->recommendedMaxWorkingSetSize()/100,
+                                context.getDevice()->maxBufferLength());
+    size_t fixedBytes = allocationSize(4*(size_t) numAtoms)+allocationSize(4*((size_t) numAtoms+1));
+    for (int size = numAtoms;; size = (size+127)/128) {
+        forceScanSizes.push_back(size);
+        fixedBytes += allocationSize(4*(size_t) ((size+127)/128));
+        if (forceScanSizes.size() > 1) fixedBytes += allocationSize(4*(size_t) size);
+        if (size <= 128) break;
+    }
+    if (budget <= fixedBytes) return;
+    unsigned int capacity = (unsigned int) min((budget-fixedBytes)/1024, (size_t) 0x7fffffff/192);
+    while (capacity > 0 && fixedBytes+allocationSize(768*(size_t) capacity)+allocationSize(256*(size_t) capacity) > budget)
+        capacity--;
+    if (capacity <= exclusionTiles.getSize()) return;
+    forceTileCapacity = capacity;
+    forceRecords.initialize<float>(context, 192*(size_t) capacity, "forceRecords");
+    forceRecordIndices.initialize<unsigned int>(context, 64*(size_t) capacity, "forceRecordIndices");
+    forceRecordCounts.initialize<unsigned int>(context, numAtoms, "forceRecordCounts");
+    forceRecordOffsets.initialize<unsigned int>(context, numAtoms+1, "forceRecordOffsets");
+    for (int level = 0; level < forceScanSizes.size(); level++) {
+        forceScanSums.push_back(make_shared<MetalArray>());
+        forceScanSums.back()->initialize<unsigned int>(context, (forceScanSizes[level]+127)/128, "forceScanSums");
+        forceScanOffsets.push_back(level == 0 ? nullptr : make_shared<MetalArray>());
+        if (level > 0) forceScanOffsets.back()->initialize<unsigned int>(context, forceScanSizes[level], "forceScanOffsets");
+    }
+    map<string, string> defines;
+    defines["NUM_ATOMS"] = context.intToString(numAtoms);
+    defines["PADDED_NUM_ATOMS"] = context.intToString(context.getPaddedNumAtoms());
+    defines["NUM_EXCLUSION_TILES"] = context.intToString(exclusionTiles.getSize());
+    defines["FORCE_TILE_CAPACITY"] = context.intToString(forceTileCapacity);
+    metalModule_t module = context.createModule(MetalKernelSources::vectorOps+MetalKernelSources::nonbondedForceRecords, defines);
