+    int my = ky < (NY+1)/2 ? ky : ky-NY;
+    int mz = kz < (NZ+1)/2 ? kz : kz-NZ;
+    float hx = mx*rx.x, hy = mx*ry.x+my*ry.y, hz = mx*rz.x+my*rz.y+mz*rz.z;
+    float m2 = hx*hx+hy*hy+hz*hz;
+    if (alpha != 0) {
+        float scale = -(2*M_PI_F/6)*SQRT(M_PI_F)*rx.x*ry.y*rz.z;
+        float m = SQRT(m2), b = (M_PI_F/alpha)*m;
+        float fac1 = 2*M_PI_F*M_PI_F*M_PI_F*SQRT(M_PI_F);
+        float fac2 = alpha*alpha*alpha, fac3 = -2*alpha*M_PI_F*M_PI_F;
+        return (fac1*ERFC(b)*(m*m2)+EXP(-b*b)*(fac2+fac3*m2))*(scale/(bx[kx]*by[ky]*bz[kz]));
+    }
+    if (kx == 0 && ky == 0 && kz == 0) return 0;
+    float scale = RECIP(M_PI_F)*rx.x*ry.y*rz.z;
+    return scale*EXP(-expFactor*m2)/(m2*bx[kx]*by[ky]*bz[kz]);
+}
+
+KERNEL void pencilsXConvolve(GLOBAL float2* RESTRICT grid, GLOBAL const float2* RESTRICT roots,
+        GLOBAL const float* RESTRICT bx, GLOBAL const float* RESTRICT by, GLOBAL const float* RESTRICT bz,
+        float4 rx, float4 ry, float4 rz, float expFactor, float alpha,
+        GLOBAL mixed* RESTRICT energyBuffer, int includeEnergy) {
+    LOCAL float2 buf[NX*BATCH], w[NX];
+    LOCAL mixed sums[256];
+    const int tid = LOCAL_ID, threads = LOCAL_SIZE;
+    mixed energy = 0;
+    loadRoots(w, roots, NX, tid, threads);
+    for (int batch = GROUP_ID; batch < NY*ZTILES; batch += NUM_GROUPS) {
+        int ky = batch/ZTILES, zbase = (batch%ZTILES)*BATCH;
+        for (int i = tid; i < NX*BATCH; i += threads) {
+            int x = i/BATCH, kz = zbase+i%BATCH;
+            buf[i] = kz < NZH ? grid[(ky*NX+x)*NZH+kz] : float2(0);
+        }
+        LOCAL_BARRIER
+#define PX_FWD(R, L) stage<R, NX, L, BATCH, 1, false, BATCH, false, false>(buf, w, tid, threads); LOCAL_BARRIER
+        STAGES_X(PX_FWD)
+        for (int i = tid; i < NX*BATCH; i += threads) {
+            int kx = freqOf<NX>(i/BATCH, RX, NUM_STAGES_X), kz = zbase+i%BATCH;
+            if (kz < NZH) {
+                float factor = pencilFactor(kx, ky, kz, bx, by, bz, rx, ry, rz, expFactor, alpha);
+                float2 value = buf[i];
+                if (includeEnergy) {
+                    // Match gridEvaluateEnergy's full spectrum even at triclinic Nyquist planes.
+                    float weight = factor;
+                    if (kz != 0 && 2*kz != NZ)
+                        weight += pencilFactor((NX-kx)%NX, (NY-ky)%NY, NZ-kz, bx, by, bz, rx, ry, rz, expFactor, alpha);
+                    energy += weight*(value.x*value.x+value.y*value.y);
+                }
+                buf[i] = value*factor;
+            }
+        }
+        LOCAL_BARRIER
+#define PX_INV(R, L) stage<R, NX, L, BATCH, 1, false, BATCH, true, true>(buf, w, tid, threads); LOCAL_BARRIER
+        STAGES_X_REV(PX_INV)
+        for (int i = tid; i < NX*BATCH; i += threads) {
+            int x = i/BATCH, kz = zbase+i%BATCH;
+            if (kz < NZH) grid[(ky*NX+x)*NZH+kz] = buf[i];
+        }
+        LOCAL_BARRIER
+    }
+    if (includeEnergy) {
+        sums[tid] = energy;
+        LOCAL_BARRIER
+        for (int offset = threads/2; offset > 0; offset /= 2) {
+            if (tid < offset) sums[tid] += sums[tid+offset];
+            LOCAL_BARRIER
+        }
+        if (tid == 0) energyBuffer[GROUP_ID] += 0.5f*sums[0];
+    }
+}
+
+KERNEL void pencilsZInverse(GLOBAL const float2* RESTRICT in, GLOBAL float* RESTRICT out,
+        GLOBAL const float2* RESTRICT roots) {
+    LOCAL float2 buf[ZPAIRS*NZ], w[NZ];
+    const int tid = LOCAL_ID, threads = LOCAL_SIZE;
+    loadRoots(w, roots, NZ, tid, threads);
+    for (int batch = GROUP_ID; batch < (NX*NY+2*ZPAIRS-1)/(2*ZPAIRS); batch += NUM_GROUPS) {
+        for (int i = tid; i < ZPAIRS*NZ; i += threads) {
+            int pair = i/NZ, kz = i%NZ, row = 2*(batch*ZPAIRS+pair);
+            int z = kz < NZH ? kz : NZ-kz;
+            float2 a = row < NX*NY ? in[row*NZH+z] : float2(0);
+            float2 b = row+1 < NX*NY ? in[(row+1)*NZH+z] : float2(0);
+            if (kz >= NZH) { a.y = -a.y; b.y = -b.y; }
+            // C2R discards the imaginary DC and (for even lengths) Nyquist components.
+            if (kz == 0 || 2*kz == NZ) { a.y = 0; b.y = 0; }
+            buf[i] = float2(a.x-b.y, a.y+b.x);
+        }
+        LOCAL_BARRIER
+#define PZ_INV(R, L) stage<R, NZ, L, ZPAIRS, NZ, false, 1, true, false>(buf, w, tid, threads); LOCAL_BARRIER
+        STAGES_Z(PZ_INV)
+        for (int i = tid; i < ZPAIRS*NZ; i += threads) {
+            int pair = i/NZ, z = i%NZ, row = 2*(batch*ZPAIRS+pair);
+            float2 value = buf[pair*NZ+posOf<NZ>(z, RZ, NUM_STAGES_Z)];
+            if (row < NX*NY) out[row*NZ+z] = value.x;
+            if (row+1 < NX*NY) out[(row+1)*NZ+z] = value.y;
+        }
+        LOCAL_BARRIER
+    }
+}
+#endif // PME_PENCILS
