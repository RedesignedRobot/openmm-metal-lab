+/**
+ * One threadgroup owns a row. SIMD groups divide the y blocks and reduce their
+ * integer sums locally before writing the radii. No cross-threadgroup handoff.
+ */
+KERNEL void computeBornSumRowOwned(GLOBAL real* RESTRICT bornRadii, GLOBAL const real4* RESTRICT posq,
+        GLOBAL const float2* RESTRICT params, real4 periodicBoxSize, real4 invPeriodicBoxSize,
+        real4 periodicBoxVecX, real4 periodicBoxVecY, real4 periodicBoxVecZ,
+        GLOBAL const real4* RESTRICT blockCenter, GLOBAL const real4* RESTRICT blockSize,
+        GLOBAL const real* RESTRICT charge, GLOBAL real* RESTRICT obcChain, GLOBAL real4* RESTRICT atomData) {
+    LOCAL mm_long sums[ROW_THREADS];
+    const unsigned int lane = LOCAL_ID%TILE_SIZE;
+    const unsigned int simd = LOCAL_ID/TILE_SIZE;
+    for (unsigned int x = GROUP_ID; x < NUM_BLOCKS; x += NUM_GROUPS) {
+        mm_long sum = 0;
+        for (unsigned int y = simd; y < NUM_BLOCKS; y += ROW_THREADS/TILE_SIZE) {
+            if (blocksInRange(blockCenter[x], blockSize[x], blockCenter[y], blockSize[y], periodicBoxSize,
+                    invPeriodicBoxSize, periodicBoxVecX, periodicBoxVecY, periodicBoxVecZ))
+                sum += realToFixedPoint(bornSumOverBlock(x, y, lane, posq, params, periodicBoxSize,
+                        invPeriodicBoxSize, periodicBoxVecX, periodicBoxVecY, periodicBoxVecZ));
+        }
+        sums[LOCAL_ID] = sum;
+        SYNC_THREADS;
+        if (simd == 0) {
+            mm_long total = 0;
+            for (unsigned int i = 0; i < ROW_THREADS/TILE_SIZE; i++)
+                total += sums[i*TILE_SIZE+lane];
+            unsigned int atom = x*TILE_SIZE+lane;
+            if (atom < NUM_ATOMS)
+                storeBornRadius(atom, total, 1.0f, 0.8f, 4.85f, params, charge, bornRadii, obcChain, atomData);
+        }
+        SYNC_THREADS;
+    }
+}
