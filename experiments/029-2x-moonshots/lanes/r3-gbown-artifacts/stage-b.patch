new file mode 100644
index 000000000..d125f985b
--- /dev/null
+++ b/platforms/metal/tests/TestMetalOwnedGB.cpp
@@ -0,0 +1,146 @@
+#include "MetalContext.h"
+#include "MetalPlatform.h"
+#include "MetalQueue.h"
+#include "openmm/internal/ContextImpl.h"
+#include "openmm/Context.h"
+#include "openmm/GBSAOBCForce.h"
+#include "openmm/HarmonicBondForce.h"
+#include "openmm/NonbondedForce.h"
+#include "openmm/State.h"
+#include "openmm/System.h"
+#include "openmm/VerletIntegrator.h"
+#include "openmm/internal/AssertionUtilities.h"
+#include <cmath>
+#include <iostream>
+#include <map>
+#include <vector>
+
+using namespace OpenMM;
+using namespace std;
+
+class QueuePlatform : public MetalPlatform {
+public:
+    MetalQueue& getQueue(Context& context) const {
+        auto* data = reinterpret_cast<PlatformData*>(getContextImpl(context).getPlatformData());
+        return data->contexts[0]->getCurrentStream();
+    }
+};
+
+static QueuePlatform platform;
+
+void checkSubmission(Context& context, VerletIntegrator& integrator) {
+    integrator.step(3);
+    MetalQueue& queue = platform.getQueue(context);
+    long long before = queue.getCommitCount();
+    integrator.step(20);
+    context.getState(State::Positions);
+    long long commits = queue.getCommitCount()-before;
+    ASSERT(commits >= 20 && commits <= 22);
+}
+
+// Exclusions remove Coulomb/LJ pairs, but must retain the OBC chain rule.
+// Moving a whole block out of range and back must refresh every owned slot.
+void testOwnedCutoffAndExclusions() {
+    System system;
+    auto* nb = new NonbondedForce();
+    auto* gb = new GBSAOBCForce();
+    auto* bonds = new HarmonicBondForce();
+    nb->setNonbondedMethod(NonbondedForce::CutoffNonPeriodic);
+    gb->setNonbondedMethod(GBSAOBCForce::CutoffNonPeriodic);
+    nb->setCutoffDistance(1.0);
+    gb->setCutoffDistance(1.0);
+    nb->setForceGroup(0);
+    gb->setForceGroup(1);
+    bonds->setForceGroup(2);
+    system.addForce(nb);
+    system.addForce(gb);
+    system.addForce(bonds);
+    vector<Vec3> positions;
+    for (int i = 0; i < 97; i++) {
+        system.addParticle(12.0);
+        double charge = (i%3-1)*0.1;
+        nb->addParticle(charge, 0.2, 0.1);
+        gb->addParticle(charge, 0.15, 0.8);
+        positions.push_back(Vec3(0.31*(i%5), 0.32*((i/5)%5), 0.33*(i/25)));
+    }
+    nb->addException(0, 1, 0, 0.2, 0);
+    nb->addException(0, 33, 0, 0.2, 0);
+    nb->addException(31, 64, 0.005, 0.21, 0.03);
+    bonds->addBond(2, 3, 0.3, 100);
+    VerletIntegrator metalIntegrator(0.001), referenceIntegrator(0.001);
+    map<string, string> properties;
+    properties["DeterministicForces"] = "true";
+    Context metal(system, metalIntegrator, platform, properties);
+    Context reference(system, referenceIntegrator, Platform::getPlatformByName("Reference"));
+    for (int snapshot = 0; snapshot < 3; snapshot++) {
+        vector<Vec3> current = positions;
+        if (snapshot == 1)
+            for (int i = 64; i < 97; i++)
+                current[i][0] += 6.0;
+        metal.setPositions(current);
+        reference.setPositions(current);
+        for (int groups : {-1, 1, 2, 4}) {
+            State expected = reference.getState(State::Forces | State::Energy, false, groups);
+            State actual = metal.getState(State::Forces | State::Energy, false, groups);
+            State forceOnly = metal.getState(State::Forces, false, groups);
+            ASSERT_EQUAL_TOL(expected.getPotentialEnergy(), actual.getPotentialEnergy(), 3e-5);
+            for (int i = 0; i < system.getNumParticles(); i++) {
+                ASSERT_EQUAL_VEC(expected.getForces()[i], actual.getForces()[i], 5e-5);
+                ASSERT_EQUAL_VEC(actual.getForces()[i], forceOnly.getForces()[i], 5e-6);
+            }
+            State energyOnly = metal.getState(State::Energy, false, groups);
+            ASSERT_EQUAL_TOL(expected.getPotentialEnergy(), energyOnly.getPotentialEnergy(), 3e-5);
+        }
+    }
+}
+
+// The conservative block rejection must not change the strict atom cutoff.
+void testOwnedCutoffBoundary() {
+    System system;
+    auto* nb = new NonbondedForce();
+    auto* gb = new GBSAOBCForce();
+    nb->setNonbondedMethod(NonbondedForce::CutoffNonPeriodic);
+    gb->setNonbondedMethod(GBSAOBCForce::CutoffNonPeriodic);
+    nb->setCutoffDistance(1.0);
+    gb->setCutoffDistance(1.0);
+    system.addForce(nb);
+    system.addForce(gb);
+    for (int i = 0; i < 2; i++) {
+        system.addParticle(12);
+        nb->addParticle(i == 0 ? 1 : -1, 0.2, 0.1);
+        gb->addParticle(i == 0 ? 1 : -1, 0.15, 0.8);
+    }
+    VerletIntegrator mi(0.001), ri(0.001);
+    Context metal(system, mi, platform);
+    Context reference(system, ri, Platform::getPlatformByName("Reference"));
+    for (double distance : {0.9999, 1.0, 1.0001}) {
+        vector<Vec3> positions = {Vec3(), Vec3(distance, 0, 0)};
+        metal.setPositions(positions);
+        // Reference's Born sums include equality. Metal's established cutoff is
+        // strict, so use the excluded side for the exact-boundary expectation.
+        if (distance == 1.0)
+            positions[1][0] = 1.0001;
+        reference.setPositions(positions);
+        State expected = reference.getState(State::Forces | State::Energy);
+        State actual = metal.getState(State::Forces | State::Energy);
+        ASSERT_EQUAL_TOL(expected.getPotentialEnergy(), actual.getPotentialEnergy(), 3e-5);
+        for (int i = 0; i < 2; i++)
+            ASSERT_EQUAL_VEC(expected.getForces()[i], actual.getForces()[i], 5e-5);
+    }
+    checkSubmission(metal, mi);
+}
+
+int main(int argc, char* argv[]) {
+    try {
+        if (argc > 1)
+            platform.setPropertyDefaultValue("Precision", argv[1]);
+        testOwnedCutoffAndExclusions();
+        testOwnedCutoffBoundary();
+    }
+    catch (const exception& e) {
+        cerr << "exception: " << e.what() << endl;
+        return 1;
+    }
+    cout << "Done" << endl;
+    return 0;
+}
